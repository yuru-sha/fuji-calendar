{
  "name": "@fuji-calendar/server",
  "version": "0.5.0",
  "description": "Fuji Calendar Express Backend",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon",
    "dev:worker": "nodemon --exec ts-node-esm src/worker.ts",
    "build": "tsc --project tsconfig.json",
    "start": "ts-node-esm --project tsconfig.json src/server.ts",
    "start:dev": "ts-node-esm --project tsconfig-node.json src/server.ts",
    "start:worker": "ts-node-esm --project tsconfig.json src/worker.ts",
    "start:worker:dev": "ts-node-esm src/worker.ts",
    "worker": "ts-node-esm src/worker.ts",
    "test": "node --loader ts-node/esm --test test/*.test.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fuji-calendar/types": "^0.5.0",
    "@fuji-calendar/utils": "^0.5.0",
    "@prisma/client": "^6.12.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.16",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^10.0.0",
    "astronomy-engine": "^2.1.19",
    "bcrypt": "^5.1.1",
    "bullmq": "^6.3.11",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.2.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.12.0",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^7.0.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "eslint": "^8.53.0",
    "nodemon": "^3.1.14"
  }
}
